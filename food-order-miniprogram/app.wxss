/* app.wxss - 全局样式 */
page {
  background-color: #F5F5F5;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #333;
  box-sizing: border-box;
}

/* 主题色变量（CSS变量在小程序中兼容性有限，用class约定代替） */

/* ============ 通用组件样式 ============ */

.btn-primary {
  background: #FF6B35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: transparent;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.btn-outline::after {
  border: none;
}

/* 卡片容器 */
.card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  overflow: hidden;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #BBBBBB;
}

.empty-state text {
  font-size: 28rpx;
  margin-top: 24rpx;
}

/* 价格文本 */
.price-text {
  color: #FF6B35;
  font-weight: 700;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #FFF3EE;
  color: #FF6B35;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 0 32rpx;
}

/* 底部安全区占位 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  min-height: 0rpx;
}
