<!-- pages/cart/cart.wxml -->
<view class="page">

  <!-- 空购物车 -->
  <view class="empty-wrap" wx:if="{{isEmpty}}">
    <text class="empty-icon">🛒</text>
    <text class="empty-text">购物车空空如也</text>
    <navigator url="/pages/home/home" open-type="switchTab">
      <view class="btn-primary go-btn">去点餐</view>
    </navigator>
  </view>

  <!-- 购物车内容 -->
  <block wx:else>

    <!-- 地址栏 -->
    <view class="section card addr-card" bindtap="onSelectAddress">
      <view class="addr-left">
        <text class="addr-icon">📍</text>
        <view wx:if="{{address}}">
          <view class="addr-name-row">
            <text class="addr-name">{{address.name}}</text>
            <text class="addr-phone">{{address.phone}}</text>
          </view>
          <text class="addr-detail">{{address.detail}}</text>
        </view>
        <text class="addr-placeholder" wx:else>选择收货地址</text>
      </view>
      <text class="addr-arrow">›</text>
    </view>

    <!-- 商品列表 -->
    <view class="section card items-card">
      <view class="section-title">
        <text>餐厅菜品</text>
        <text class="clear-btn" bindtap="onClear">清空</text>
      </view>

      <view class="cart-item" wx:for="{{cartItems}}" wx:key="dishId">
        <image class="item-img" src="{{item.imageUrl}}" mode="aspectFill"/>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <view class="item-footer">
            <text class="item-price">¥{{item.price / 100}}</text>
            <view class="stepper">
              <view class="step-btn minus" bindtap="onMinus" data-dishid="{{item.dishId}}">−</view>
              <text class="step-qty">{{item.quantity}}</text>
              <view class="step-btn plus" bindtap="onAdd" data-item="{{item}}">+</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="section card remark-card">
      <view class="remark-label">
        <text>✏️</text>
        <text>备注</text>
      </view>
      <input
        class="remark-input"
        placeholder="有什么特殊要求告诉商家..."
        placeholder-style="color:#ccc"
        maxlength="100"
        bindinput="onRemarkInput"
        value="{{remark}}"
      />
    </view>

    <!-- 费用明细 -->
    <view class="section card fee-card">
      <view class="fee-row">
        <text class="fee-label">商品合计</text>
        <text class="fee-value">¥{{subtotal}}</text>
      </view>
      <view class="fee-row">
        <text class="fee-label">配送费</text>
        <text class="fee-value">¥{{deliveryFee}}</text>
      </view>
      <view class="divider" style="margin: 16rpx 0;"></view>
      <view class="fee-row total-row">
        <text class="fee-label">合计</text>
        <text class="fee-total">¥{{total}}</text>
      </view>
    </view>

    <!-- 底部占位 -->
    <view style="height: 180rpx;"></view>

  </block>

  <!-- 底部结算栏 -->
  <view class="checkout-bar" wx:if="{{!isEmpty}}">
    <view class="checkout-total">
      <text class="checkout-label">实付</text>
      <text class="checkout-price">¥{{total}}</text>
    </view>
    <view class="checkout-btn" bindtap="onCheckout">立即结算</view>
  </view>

</view>
