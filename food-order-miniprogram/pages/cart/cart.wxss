/* pages/cart/cart.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #BBBBBB;
  margin: 24rpx 0 48rpx;
}

.go-btn {
  width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #FF6B35;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* 通用 section */
.section {
  border-radius: 20rpx;
  background: #fff;
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* 地址卡片 */
.addr-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.addr-left {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 16rpx;
  min-width: 0;
}

.addr-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.addr-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.addr-name {
  font-size: 28rpx;
  font-weight: 600;
}

.addr-phone {
  font-size: 26rpx;
  color: #999;
}

.addr-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.addr-placeholder {
  font-size: 28rpx;
  color: #999;
}

.addr-arrow {
  font-size: 36rpx;
  color: #CCC;
  margin-left: 12rpx;
}

/* 商品卡片 */
.items-card {
  padding: 0;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.clear-btn {
  font-size: 26rpx;
  color: #999;
  font-weight: 400;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #F5F5F5;
}

.item-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.item-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
}

.item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B35;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 300;
}

.step-btn.plus { background: #FF6B35; color: #fff; }
.step-btn.minus { background: #f0f0f0; color: #333; }

.step-qty {
  font-size: 30rpx;
  font-weight: 600;
  min-width: 40rpx;
  text-align: center;
}

/* 备注 */
.remark-card {
  padding: 28rpx 32rpx;
}

.remark-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.remark-input {
  width: 100%;
  font-size: 26rpx;
  color: #333;
  min-height: 60rpx;
  line-height: 1.6;
}

/* 费用明细 */
.fee-card {
  padding: 28rpx 32rpx;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.fee-row:last-child {
  margin-bottom: 0;
}

.fee-label {
  font-size: 28rpx;
  color: #666;
}

.fee-value {
  font-size: 28rpx;
  color: #333;
}

.total-row .fee-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.fee-total {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B35;
}

/* 结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  height: calc(120rpx + env(safe-area-inset-bottom));
  padding: 16rpx 32rpx env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}

.checkout-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.checkout-label {
  font-size: 26rpx;
  color: #666;
}

.checkout-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B35;
}

.checkout-btn {
  background: #FF6B35;
  color: #fff;
  border-radius: 100rpx;
  padding: 0 64rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
}
