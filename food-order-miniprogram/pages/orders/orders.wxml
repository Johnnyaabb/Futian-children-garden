<!-- pages/orders/orders.wxml -->
<view class="page">

  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view
      class="order-card card"
      wx:for="{{orders}}"
      wx:key="orderId"
      bindtap="onOrderTap"
      data-orderid="{{item.orderId}}"
    >
      <!-- 订单头 -->
      <view class="order-header">
        <text class="order-no">订单号 {{item.orderNo}}</text>
        <text class="order-status" style="color:{{statusColorMap[item.status]}}">
          {{statusMap[item.status]}}
        </text>
      </view>

      <!-- 菜品预览 -->
      <view class="items-preview">
        <view class="preview-imgs">
          <image
            wx:for="{{item.items}}"
            wx:for-item="dish"
            wx:key="dishId"
            wx:if="{{index < 3}}"
            src="{{dish.imageUrl}}"
            mode="aspectFill"
            class="preview-img"
          />
          <view class="more-badge" wx:if="{{item.items.length > 3}}">
            +{{item.items.length - 3}}
          </view>
        </view>
        <view class="items-summary">
          <text class="items-names">
            <block wx:for="{{item.items}}" wx:for-item="dish" wx:key="dishId">
              {{dish.name}} x{{dish.quantity}}{{index < item.items.length - 1 ? '、' : ''}}
            </block>
          </text>
          <text class="order-total">¥{{item.total / 100}}</text>
        </view>
      </view>

      <!-- 时间和箭头 -->
      <view class="order-footer">
        <text class="order-time">{{item.createdAt}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📦</text>
    <text class="empty-text">暂无订单记录</text>
    <navigator url="/pages/home/home" open-type="switchTab">
      <view class="go-order-btn">去点餐</view>
    </navigator>
  </view>

</view>
