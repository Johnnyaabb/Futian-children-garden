/* pages/orders/orders.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
}

.order-list { }

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-no {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 28rpx;
  font-weight: 600;
}

/* 菜品预览 */
.items-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.preview-imgs {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.preview-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  object-fit: cover;
}

.more-badge {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

.items-summary {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100rpx;
  min-width: 0;
}

.items-names {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.order-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B35;
  margin-top: 12rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.order-time {
  font-size: 24rpx;
  color: #BBBBBB;
}

.arrow {
  font-size: 36rpx;
  color: #CCC;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
}

.empty-text {
  font-size: 30rpx;
  color: #BBBBBB;
  margin: 24rpx 0 48rpx;
}

.go-order-btn {
  background: #FF6B35;
  color: #fff;
  border-radius: 100rpx;
  padding: 0 64rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
