/* pages/merchant/merchant.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* Header */
.header {
  background: linear-gradient(135deg, #333, #555);
  padding: 48rpx 40rpx 32rpx;
}

.shop-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.header-date {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 8rpx;
  display: block;
}

/* Tab */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #999;
  position: relative;
}

.tab-item.active {
  color: #FF6B35;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background: #FF6B35;
  border-radius: 2rpx;
}

/* 菜品列表 */
.dish-list {
  padding: 20rpx 24rpx;
}

.dish-manage-card {
  display: flex;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.dish-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.dish-content {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.avail-switch {
  transform: scale(0.8);
}

.dish-cat-price {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 600;
}

.dish-stock {
  font-size: 24rpx;
  color: #999;
}

.dish-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn.edit {
  background: #E8F0FF;
  color: #3478F6;
}

.action-btn.delete {
  background: #FFE8E8;
  color: #FF3B30;
}

.action-btn.accept {
  background: #FF6B35;
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.action-btn.complete {
  background: #34C759;
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.action-btn.detail {
  background: #f0f0f0;
  color: #666;
  padding: 12rpx 32rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.avail-tag {
  background: #E6F9EE;
  color: #34C759;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.unavail-tag {
  background: #F5F5F5;
  color: #999;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* 订单列表 */
.order-list {
  padding: 20rpx 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

.order-items-preview {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.order-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.order-addr {
  font-size: 24rpx;
  color: #999;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-total {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B35;
}

.order-time {
  font-size: 22rpx;
  color: #BBBBBB;
  display: block;
  margin-bottom: 8rpx;
}

.order-remark {
  font-size: 24rpx;
  color: #FF8C5A;
  background: #FFF3EE;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  margin: 8rpx 0;
  display: block;
}

.order-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  justify-content: flex-end;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 60rpx;
  color: #BBBBBB;
  font-size: 28rpx;
}

/* FAB 按钮 */
.fab {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  right: 40rpx;
  background: #FF6B35;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  padding: 0 36rpx;
  height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.4);
  z-index: 50;
}

.fab-icon {
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  margin-right: 12rpx;
}

.fab-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 99;
}

.modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 0 env(safe-area-inset-bottom);
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 90vh;
  overflow-y: auto;
}

.modal.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 1;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

/* 图片上传 */
.img-upload {
  margin: 24rpx 40rpx;
  height: 240rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F8F8F8;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #DDD;
}

.upload-preview {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-icon {
  font-size: 64rpx;
}

.upload-hint {
  font-size: 26rpx;
  color: #999;
}

/* 表单 */
.form-group {
  padding: 20rpx 40rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  font-size: 30rpx;
  color: #222;
  height: 72rpx;
  width: 100%;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 72rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #222;
}

.picker-arrow {
  color: #CCC;
  font-size: 36rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #222;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 弹窗底部按钮 */
.modal-footer {
  padding: 32rpx 40rpx;
}

.save-btn {
  background: #FF6B35;
  color: #fff;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}
