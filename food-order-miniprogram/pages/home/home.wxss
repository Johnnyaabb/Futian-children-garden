/* pages/home/home.wxss */

.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 顶部横幅 */
.banner {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  padding: 40rpx 40rpx 60rpx;
  position: relative;
}

.banner-date {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.banner-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* 分类栏 */
.category-bar {
  background: #fff;
  white-space: nowrap;
  padding: 20rpx 24rpx;
  margin-top: -30rpx;
  border-radius: 24rpx 24rpx 0 0;
  position: relative;
  z-index: 1;
}

.category-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
  background: #F5F5F5;
  transition: all 0.2s;
}

.category-item.active {
  background: #FF6B35;
  color: #fff;
  font-weight: 600;
}

/* 菜品列表 */
.dish-list {
  padding: 16rpx 24rpx;
}

.dish-card {
  display: flex;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.dish-img {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.dish-info {
  flex: 1;
  padding: 24rpx 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.dish-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-top: 8rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.dish-price-wrap {
  display: flex;
  align-items: baseline;
  color: #FF6B35;
}

.price-unit {
  font-size: 24rpx;
  font-weight: 700;
}

.price-num {
  font-size: 36rpx;
  font-weight: 700;
  margin-left: 2rpx;
}

.stock-tip {
  font-size: 22rpx;
  color: #FF6B35;
}

.stock-tip.sold-out {
  color: #999;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.step-btn.plus {
  background: #FF6B35;
  color: #fff;
}

.step-btn.minus {
  background: #f0f0f0;
  color: #333;
}

.step-btn.hidden {
  display: none;
}

.step-qty {
  font-size: 28rpx;
  font-weight: 600;
  min-width: 32rpx;
  text-align: center;
}

.step-qty.hidden {
  display: none;
}

/* 购物车悬浮栏 */
.cart-bar {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 100rpx);
  left: 24rpx;
  right: 24rpx;
  background: #333;
  border-radius: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx 0 20rpx;
  z-index: 100;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s;
  pointer-events: none;
}

.cart-bar.visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.cart-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  background: #FF6B35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cart-icon {
  font-size: 36rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #FF3B30;
  color: #fff;
  border-radius: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.cart-bar-text {
  color: #fff;
  font-size: 26rpx;
  margin-left: 20rpx;
  flex: 1;
}

.cart-bar-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cart-total {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.cart-go-btn {
  background: #FF6B35;
  color: #fff;
  border-radius: 100rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* 空状态 */
.empty-icon {
  font-size: 100rpx;
  display: block;
  text-align: center;
  margin-top: 120rpx;
}

.empty-state text:last-child {
  font-size: 28rpx;
  color: #BBBBBB;
  text-align: center;
  display: block;
  margin-top: 24rpx;
}
