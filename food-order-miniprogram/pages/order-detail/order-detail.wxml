<!-- pages/order-detail/order-detail.wxml -->
<view class="page" wx:if="{{order}}">

  <!-- 状态横幅 -->
  <view class="status-banner" style="background: {{statusColorMap[order.status]}}">
    <text class="status-icon">{{statusIconMap[order.status]}}</text>
    <text class="status-text">{{statusMap[order.status]}}</text>
    <text class="order-no-text">订单号：{{order.orderNo}}</text>
  </view>

  <!-- 进度条 -->
  <view class="steps-card card" wx:if="{{order.status !== 'cancelled'}}">
    <view class="steps">
      <view class="step {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}" wx:for="{{steps}}" wx:key="key">
        <view class="step-dot">
          <text wx:if="{{item.done}}">✓</text>
        </view>
        <text class="step-label">{{item.label}}</text>
        <view class="step-line" wx:if="{{index < steps.length - 1}}"></view>
      </view>
    </view>
  </view>

  <!-- 取消提示 -->
  <view class="cancel-banner" wx:if="{{order.status === 'cancelled'}}">
    <text>❌ 该订单已取消</text>
  </view>

  <!-- 收货地址 -->
  <view class="section card">
    <view class="section-header">收货地址</view>
    <view class="addr-info">
      <text class="addr-name">{{order.address.name}}</text>
      <text class="addr-phone">{{order.address.phone}}</text>
      <text class="addr-detail">{{order.address.detail}}</text>
    </view>
  </view>

  <!-- 商品清单 -->
  <view class="section card">
    <view class="section-header">商品清单</view>
    <view class="order-item" wx:for="{{order.items}}" wx:key="dishId">
      <image class="item-img" src="{{item.imageUrl}}" mode="aspectFill"/>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-qty">x {{item.quantity}}</text>
      </view>
      <text class="item-price">¥{{item.subtotal / 100}}</text>
    </view>
    <text class="order-remark" wx:if="{{order.remark}}">备注：{{order.remark}}</text>
  </view>

  <!-- 费用明细 -->
  <view class="section card">
    <view class="section-header">费用明细</view>
    <view class="fee-row">
      <text class="fee-label">商品合计</text>
      <text class="fee-value">¥{{order.subtotal / 100}}</text>
    </view>
    <view class="fee-row">
      <text class="fee-label">配送费</text>
      <text class="fee-value">¥{{order.deliveryFee / 100}}</text>
    </view>
    <view class="divider" style="margin: 16rpx 0;"></view>
    <view class="fee-row">
      <text class="fee-label-bold">实付金额</text>
      <text class="fee-total">¥{{order.total / 100}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section card">
    <view class="section-header">订单信息</view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.createdAt}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{order.orderNo}}</text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view style="height: 180rpx;"></view>

  <!-- 操作按钮 -->
  <view class="bottom-bar">
    <view class="cancel-btn" bindtap="onCancelOrder" wx:if="{{order.status === 'paid'}}">取消订单</view>
    <view class="reorder-btn" bindtap="onReorder" wx:if="{{order.status === 'completed' || order.status === 'cancelled'}}">再来一单</view>
  </view>

</view>
