/* pages/order-detail/order-detail.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 状态横幅 */
.status-banner {
  padding: 48rpx 40rpx 56rpx;
  color: #fff;
}

.status-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.order-no-text {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
}

/* 进度步骤 */
.steps-card {
  margin: -24rpx 24rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  padding: 32rpx 24rpx;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.steps {
  display: flex;
  align-items: flex-start;
  position: relative;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  z-index: 1;
  font-weight: 700;
  flex-shrink: 0;
}

.step.done .step-dot {
  background: #FF6B35;
}

.step.current .step-dot {
  background: #FF6B35;
  box-shadow: 0 0 0 6rpx rgba(255,107,53,0.2);
}

.step-label {
  font-size: 20rpx;
  color: #BBBBBB;
  margin-top: 10rpx;
  text-align: center;
  line-height: 1.4;
  white-space: nowrap;
}

.step.done .step-label,
.step.current .step-label {
  color: #333;
}

.step-line {
  position: absolute;
  top: 18rpx;
  left: 50%;
  right: -50%;
  height: 3rpx;
  background: #E0E0E0;
}

.step.done .step-line {
  background: #FF6B35;
}

/* 取消横幅 */
.cancel-banner {
  margin: -24rpx 24rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  padding: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #FF3B30;
  position: relative;
  z-index: 1;
}

/* 各 section */
.section {
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-header {
  font-size: 28rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

/* 地址 */
.addr-info {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.addr-name {
  font-size: 28rpx;
  font-weight: 600;
}

.addr-phone {
  font-size: 26rpx;
  color: #999;
}

.addr-detail {
  font-size: 26rpx;
  color: #666;
  width: 100%;
  line-height: 1.5;
}

/* 订单商品 */
.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
}

.order-item:last-of-type {
  border-bottom: none;
}

.item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.item-info {
  flex: 1;
  margin: 0 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
}

.item-qty {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.order-remark {
  font-size: 24rpx;
  color: #FF8C5A;
  background: #FFF3EE;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 16rpx;
  display: block;
}

/* 费用 */
.fee-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.fee-row:last-child { margin-bottom: 0; }

.fee-label {
  font-size: 28rpx;
  color: #666;
}

.fee-value {
  font-size: 28rpx;
  color: #333;
}

.fee-label-bold {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.fee-total {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B35;
}

/* 订单信息 */
.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

/* 底部操作 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 40rpx env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.cancel-btn {
  border: 2rpx solid #DDD;
  color: #666;
  border-radius: 100rpx;
  padding: 0 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.reorder-btn {
  background: #FF6B35;
  color: #fff;
  border-radius: 100rpx;
  padding: 0 64rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
